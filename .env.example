# The default is the named Docker volume waypoint-data.
# Set an absolute host path to use a bind mount instead, for example:
# WAYPOINT_DATA_PATH=/srv/waypoint

# Exact URL users will open. Change this for another LAN host or HTTPS proxy.
WAYPOINT_PUBLIC_URL=http://localhost:4173

# Leave empty to infer false for HTTP and true for an https public URL.
WAYPOINT_SECURE_COOKIES=

# Optional comma-separated exact aliases; never use a wildcard.
WAYPOINT_TRUSTED_HOSTS=
WAYPOINT_TRUSTED_ORIGINS=
WAYPOINT_LOG_LEVEL=info
